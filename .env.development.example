NODE_ENV=development
PORT=4000
FRONTEND_ORIGINS=http://localhost:3000

# Optional fallback when the system resolver cannot resolve MongoDB Atlas SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional. Omit to use an ephemeral in-memory MongoDB database.
# MONGODB_URI=mongodb://127.0.0.1:27017/beone-production

JWT_ACCESS_SECRET=development-access-secret-change-before-production
JWT_REFRESH_SECRET=development-refresh-secret-change-before-production
MFA_ENCRYPTION_KEY=development-mfa-encryption-key-change-before-production
MFA_CHALLENGE_SECRET=development-mfa-challenge-secret-change-before-production
MFA_ISSUER=Beone Production
MFA_CHALLENGE_EXPIRES=5m
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
BCRYPT_ROUNDS=10

# Responses larger than this many bytes are compressed.
COMPRESSION_THRESHOLD_BYTES=1024
