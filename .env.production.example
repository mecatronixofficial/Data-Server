NODE_ENV=production
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-long-random-mfa-encryption-secret
MFA_CHALLENGE_SECRET=replace-with-a-different-long-random-mfa-challenge-secret
MFA_ISSUER=Beone Production
MFA_CHALLENGE_EXPIRES=5m
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=true
FRONTEND_ORIGINS=https://your-frontend-domain.vercel.app
REQUEST_BODY_LIMIT=1mb
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=1
BCRYPT_ROUNDS=12

# Optional when the hosting provider cannot resolve MongoDB SRV records.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
