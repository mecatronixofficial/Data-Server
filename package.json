{
  "name": "beone-production-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.19 <27",
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node -e \"process.env.NODE_ENV='production'; require('./dist/main')\"",
    "migrate:team-reports": "ts-node -r tsconfig-paths/register src/migrations/migrate-team-reports.ts",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "mongoose": "^9.9.5",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/qrcode": "^1.5.6",
    "mongodb-memory-server": "^11.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "browserslist": "4.28.9",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.1",
    "lodash": "4.18.1",
    "qs": "6.16.0",
    "uuid": "11.1.1"
  }
}
